# Provider API Keys
# Set any combination  - the server auto-detects which are available
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
ZAI_API_KEY=
QWEN_API_KEY=
OPENCODE_ZEN_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=  # Required when CLOUDFLARE_API_KEY is set
GOOGLE_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
FIREWORKS_API_KEY=
AION_API_KEY=
COHERE_API_KEY=
GITHUB_API_KEY=
META_API_KEY=

# Bedrock (AWS). AWS_SESSION_TOKEN only needed for temporary/STS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_SESSION_TOKEN=

# xAI Grok OAuth (SuperGrok / X Premium+) and OpenAI ChatGPT/Codex OAuth are
# device-code logins, not env-var keys -- run:
#   node bin/acptoapi.js --xai-oauth-login
#   node bin/acptoapi.js --openai-oauth-login

# Fallback priority order (comma-separated provider names)
# Default: anthropic,openrouter,groq,nvidia,cerebras,sambanova,mistral,codestral,qwen,zai,
#   github-models,cloudflare,gemini,bedrock,opencode-zen,opencode-north,opencode,mimo,ollama,
#   xai-oauth,kilo,qwen-code,codex-cli,copilot-cli,cline,hermes-agent,cursor-acp,codeium-cli,
#   acp-cli,chatjimmy,cohere,aion
# PROVIDER_ORDER=groq,nvidia,openrouter

# Optional local Ollama endpoint
OLLAMA_URL=http://localhost:11434

# Optional local LibreChat aggregator endpoint (self-hosted OpenAI-compat frontend)
# LIBRECHAT_API_KEY only needed if the LibreChat instance requires auth
LIBRECHAT_URL=http://localhost:3040/v1
LIBRECHAT_API_KEY=

# Server auth key (leave blank to disable; REQUIRED if ACPTOAPI_BIND is non-loopback)
# ACPTOAPI_API_KEY is the canonical name; AGENTAPI_API_KEY accepted as legacy alias.
ACPTOAPI_API_KEY=

# Bind address (default: 127.0.0.1 / loopback only). Set to 0.0.0.0 to expose
# on LAN, but then ACPTOAPI_API_KEY MUST also be set or anyone on the network
# can spend your provider API keys.
# ACPTOAPI_BIND=127.0.0.1
